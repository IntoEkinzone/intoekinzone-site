---
import { Image } from "astro:assets";
import { allArtworks, type Artwork } from "@/lib/artworks";
import { widthsFor } from "@/lib/responsive-widths";
import ChevronLeft from "@/assets/icons/chevron-left.svg";
import ChevronRight from "@/assets/icons/chevron-right.svg";
import Default from "@/layouts/Default.astro";

export function getStaticPaths() {
  return allArtworks.map((artwork) => ({
    params: {
      year: artwork.year,
      piece: artwork.slug,
    },
    props: { artwork },
  }));
}

const { artwork } = Astro.props as { artwork: Artwork };

const title = artwork.name;

const imageUrl = new URL(artwork.metadata.src, Astro.site).href;

const currentIndex = allArtworks.findIndex(
  (art) => art.slug === artwork.slug && art.year === artwork.year,
);
const previousArtwork = allArtworks[currentIndex - 1];
const nextArtwork = allArtworks[currentIndex + 1];
---

<Default
  title={`${title} — ${artwork.year} | IntoEkinZone`}
  description={`${title}, an artwork from ${artwork.year}.`}
  ogType="article"
  ogImage={imageUrl}
  twitterCard="summary_large_image"
>
  <body
    class="h-dvh w-dvw overflow-hidden"
    data-prev={previousArtwork
      ? `/${previousArtwork.year}/${previousArtwork.slug}`
      : ""}
    data-next={nextArtwork ? `/${nextArtwork.year}/${nextArtwork.slug}` : ""}
  >
    <div class="flex flex-col h-full w-full box-border">
      <header id="header" class="flex-none rounded pt-1 pb-2">
        <div class="text-center">
          <a class="text-1xl hover:underline" href={`/${artwork.year}`}
            >&larr; Back to {artwork.year}</a
          >
          <span class="mx-1">|</span>
          <a class="text-1xl hover:underline" href="/">All Years</a>
        </div>
        <h1 class="text-4xl text-mustard font-bold text-center">{title}</h1>
      </header>
      <main
        id="content"
        class="flex-1 flex-col md:flex-row min-h-0 flex items-center justify-center pb-0 md:pb-2 w-full"
      >
        <div class="flex-none min-w-0 md:min-w-8 hidden md:block">
          {
            previousArtwork && (
              <a
                href={`/${previousArtwork.year}/${previousArtwork.slug}`}
                class="hover:text-mustard transition"
                aria-label="Previous artwork"
              >
                <ChevronLeft width={64} height={64} />
              </a>
            )
          }
        </div>
        <div
          class="flex-1 min-w-0 h-full flex items-center justify-center px-4"
        >
          <Image
            src={artwork.metadata}
            alt={title}
            style={`aspect-ratio: ${artwork.metadata.width} / ${artwork.metadata.height};`}
            widths={widthsFor(artwork.metadata.width)}
            class="max-h-full max-w-full object-contain rounded-lg shadow-lg w-auto h-auto"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="flex-none min-w-0 md:min-w-8 hidden md:block">
          {
            nextArtwork && (
              <a
                href={`/${nextArtwork.year}/${nextArtwork.slug}`}
                class="hover:text-mustard transition"
                aria-label="Next artwork"
              >
                <ChevronRight width={64} height={64} />
              </a>
            )
          }
        </div>
      </main>
      <!-- We use px values here cus... it doesn't work if not -->
      <footer id="footer" class="py-1 md:hidden">
        <div class="flex flex-row items-center justify-center gap-x-2">
          <div class="w-[48px] flex justify-center">
            {
              previousArtwork && (
                <a
                  href={`/${previousArtwork.year}/${previousArtwork.slug}`}
                  class="hover:text-mustard transition"
                  aria-label="Previous artwork"
                >
                  <ChevronLeft width={48} height={48} />
                </a>
              )
            }
          </div>
          <div class="w-[48px] flex justify-center">
            {
              nextArtwork && (
                <a
                  href={`/${nextArtwork.year}/${nextArtwork.slug}`}
                  class="hover:text-mustard transition"
                  aria-label="Next artwork"
                >
                  <ChevronRight width={48} height={48} />
                </a>
              )
            }
          </div>
        </div>
      </footer>
    </div>
    <script>
      const body = document.querySelector("body");
      if (body) {
        const prevUrl = body.dataset.prev;
        const nextUrl = body.dataset.next;

        function goToPrevious() {
          if (prevUrl) window.location.assign(prevUrl);
        }

        function goToNext() {
          if (nextUrl) window.location.assign(nextUrl);
        }

        addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") goToPrevious();
          else if (e.key === "ArrowRight") goToNext();
        });

        let touchStartX = 0;
        let touchStartY = 0;

        addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length !== 1) return;
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          },
          { passive: true },
        );

        addEventListener(
          "touchend",
          (e) => {
            if (e.changedTouches.length !== 1) return;
            const deltaX = e.changedTouches[0].clientX - touchStartX;
            const deltaY = e.changedTouches[0].clientY - touchStartY;

            const MIN_SWIPE_DISTANCE = 50;
            const isHorizontal = Math.abs(deltaX) > Math.abs(deltaY);
            if (!isHorizontal || Math.abs(deltaX) < MIN_SWIPE_DISTANCE) return;

            if (deltaX > 0) goToPrevious();
            else goToNext();
          },
          { passive: true },
        );
      }
    </script>
  </body>
</Default>
