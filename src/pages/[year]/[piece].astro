---
import { Image } from "astro:assets";
import { allArtworks, type Artwork } from "@/lib/artworks";
import "@/styles/global.css";
import ChevronLeft from "@/svg/chevron-left.svg";
import ChevronRight from "@/svg/chevron-right.svg";

export function getStaticPaths() {
  return allArtworks.map((artwork) => ({
    params: {
      year: artwork.year,
      piece: artwork.slug,
    },
    props: { artwork },
  }));
}

const { artwork } = Astro.props as { artwork: Artwork };

const title = artwork.name;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const imageUrl = new URL(artwork.metadata.src, Astro.site).href;

const currentIndex = allArtworks.findIndex(
  (art) => art.slug === artwork.slug && art.year === artwork.year,
);
const previousArtwork = allArtworks[currentIndex - 1];
const nextArtwork = allArtworks[currentIndex + 1];

const oEmbedUrl = new URL("/api/oembed.json", Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} — {artwork.year} | IntoEkinZone</title>
    <link
      rel="preload"
      href="/fonts/Oswald-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:description" content={`Artwork from ${artwork.year}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="alternate" type="application/json+oembed" href={oEmbedUrl} />
  </head>
  <body
    class="h-dvh w-dvw overflow-hidden bg-gray-900 text-white"
    data-prev={previousArtwork
      ? `/${previousArtwork.year}/${previousArtwork.slug}`
      : ""}
    data-next={nextArtwork ? `/${nextArtwork.year}/${nextArtwork.slug}` : ""}
  >
    <div class="flex flex-col h-full w-full box-border">
      <div id="header" class="flex-none rounded pt-1 pb-2">
        <div class="text-center">
          <a class="text-1xl hover:underline" href={`/${artwork.year}`}
            >&larr; Back to {artwork.year}</a
          >
          <span class="mx-1">|</span>
          <a class="text-1xl hover:underline" href="/">All Years</a>
        </div>
        <h1 class="text-4xl text-mustard font-bold text-center">{title}</h1>
      </div>
      <div
        id="content"
        class="flex-1 flex-col md:flex-row min-h-0 flex items-center justify-center pb-0 md:pb-2 w-full"
      >
        <div class="flex-none min-w-0 md:min-w-8 hidden md:block">
          {
            previousArtwork && (
              <a
                href={`/${previousArtwork.year}/${previousArtwork.slug}`}
                class="hover:text-mustard transition"
                aria-label="Previous artwork"
              >
                <ChevronLeft width={64} height={64} />
              </a>
            )
          }
        </div>
        <div
          class="flex-1 min-w-0 h-full flex items-center justify-center px-4"
        >
          <Image
            src={artwork.metadata}
            alt={title}
            class="max-h-full max-w-full object-contain rounded-lg shadow-lg w-auto h-auto"
          />
        </div>
        <div class="flex-none min-w-0 md:min-w-8 hidden md:block">
          {
            nextArtwork && (
              <a
                href={`/${nextArtwork.year}/${nextArtwork.slug}`}
                class="hover:text-mustard transition"
                aria-label="Next artwork"
              >
                <ChevronRight width={64} height={64} />
              </a>
            )
          }
        </div>
      </div>
      <!-- We use px values here cus... it doesn't work if not -->
      <div id="footer" class="py-1 md:hidden">
        <div class="flex flex-row items-center justify-center gap-x-2">
          <div class="w-[48px] flex justify-center">
            {
              previousArtwork && (
                <a
                  href={`/${previousArtwork.year}/${previousArtwork.slug}`}
                  class="hover:text-mustard transition"
                  aria-label="Previous artwork"
                >
                  <ChevronLeft width={48} height={48} />
                </a>
              )
            }
          </div>
          <div class="w-[48px] flex justify-center">
            {
              nextArtwork && (
                <a
                  href={`/${nextArtwork.year}/${nextArtwork.slug}`}
                  class="hover:text-mustard transition"
                  aria-label="Next artwork"
                >
                  <ChevronRight width={48} height={48} />
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
    <script>
      const body = document.querySelector("body");
      if (body) {
        const prevUrl = body.dataset.prev;
        const nextUrl = body.dataset.next;
        addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            if (prevUrl) {
              console.debug("Navigating left");
              window.location.assign(prevUrl);
            } else {
              console.debug("No artwork left");
            }
          } else if (e.key === "ArrowRight") {
            if (nextUrl) {
              console.debug("Navigating right");
              window.location.assign(nextUrl);
            } else {
              console.debug("No artwork right");
            }
          }
        });
      }
    </script>
  </body>
</html>
