---
import { artworksByYear } from "@/lib/artworks";
import Default from "@/layouts/Default.astro";

export function getStaticPaths() {
  const years = Object.keys(artworksByYear);
  return years.map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const artworks = artworksByYear[year] ?? [];
---

<Default
  title={`Artworks from ${year} | IntoEkinZone`}
  description={`Artwork from ${year}`}
>
  <body class="p-8">
    <header class="mb-4">
      <h1 class="text-4xl text-mustard font-bold mb-1">{year}</h1>
      <a class="text-1xl text-white hover:underline" href="/"
        >Back to Front Page</a
      >
    </header>

    <main>
      <ul class="space-y-2">
        {
          artworks.map(({ name, slug }) => (
            <li>
              <a
                class="text-2xl white hover:underline"
                href={`/${year}/${slug}`}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</Default>
